<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_purchase_new_officer" model="res.groups">
            <field name="name">Purchase New Officer</field>
            <!-- Inherit Internal User -->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <!-- Optional: show under Purchase application -->
            <field name="category_id" ref="base.module_category_inventory_purchase"/>
        </record>

        <record id="group_purchase_new_manager" model="res.groups">
            <field name="name">Purchase New Manager</field>
            <!-- Inherit Officer User -->
            <field name="implied_ids" eval="[(4, ref('group_purchase_new_officer'))]"/>
            <field name="category_id" ref="base.module_category_inventory_purchase"/>
        </record>

        <record id="purchase_new_rule_officer" model="ir.rule">
            <field name="name">Purchase New Officer</field>
            <field name="model_id" ref="model_purchase_new"/>
            <field name="groups" eval="[(4, ref('group_purchase_new_officer'))]"/>
            <field name="domain_force">
                [('create_uid', '=', user.id)]
            </field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="purchase_new_rule_manager" model="ir.rule">
            <field name="name">Purchase New Manager</field>
            <field name="model_id" ref="model_purchase_new"/>
            <field name="groups" eval="[(4, ref('group_purchase_new_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

    </data>
</odoo>