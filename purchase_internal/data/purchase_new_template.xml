<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="email_template_purchase_new_order" model="mail.template">
        <field name="name">Purchase Order Email</field>
        <field name="model_id" ref="model_purchase_new"/>
        <field name="subject">Purchase New {{ object.name }}</field>

        <field name="email_from">{{ object.user_id.email_formatted or user.email_formatted }}</field>
        <field name="email_to">{{ object.partner_id.email_formatted }}</field>

        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p>
                    Dear <t t-out="object.partner_id.name or ''">Customer</t>,<br/><br/>
                    Thank you for your interest in our products.
                    Please find your <strong>Purchase New Order</strong> details below:
                    <br/><br/>
                    <strong>Order Reference:</strong> <t t-out="object.name or ''"/><br/>
                    <br/>
                    If you have any questions, please contact us.
                </p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>