<odoo>
    <data noupdate="1">

        <record id="ir_sequence_purchase_new" model="ir.sequence">
           <field name="name">Purchase New</field>
           <field name="code">purchase.new</field>
           <field name="prefix">PN/%(day)s/%(month)s/%(year)s/</field>
           <field name="padding">5</field>
           <field name="number_next">1</field>
           <field name="number_increment">1</field>
           <field name="company_id" eval="False"/>
       </record>

<!--        <record id="seq_purchase_new" model="ir.sequence">-->
