<!--        </record>-->

        <record forcecreate="True" id="otp_expire_update" model="ir.cron">
            <field name="name">OTP Expire: Cleanup Expired Codes</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="model_id" ref="model_generate_otp"/>
            <field name="state">code</field>
            <field name="code">model.otp_expire()</field>
        </record>
    </data>
</odoo>