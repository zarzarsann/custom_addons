<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="purchase_new_tree" model="ir.ui.view">
        <field name="name">purchase.new.list</field>
        <field name="model">purchase.new</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <list string="Purchase New">
                <field name="name"/>
                <field name="description"/>
                <field name="partner_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_purchase_new_form" model="ir.ui.view">
        <field name="name">purchase.new.form</field>
        <field name="model">purchase.new</field>
        <field name="arch" type="xml">
            <form string="Purchase New">
                <header>
                    <button name="%(action_purchase_new_wizard)d" string="Wizard" type="action" class="btn-primary"/>
                    <button name="action_send_mail" string="Send Mail" type="object" class="btn-primary"/>
<!--                    <button string="Cancel" special="cancel" class="btn-secondary"/>-->
                    <button name="action_confirm" string="Confirm" type="object"/>
                    <button name="action_cancel" string="Cancel" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,purchase" readonly="1"/>
               </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1" force_save="1"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="description"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id" options="{'no_open': True, 'no_create': True}" class="oe_online"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
               <chatter/>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_purchase_new" model="ir.actions.act_window">
        <field name="name">Purchase New</field>
        <field name="res_model">purchase.new</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <!-- Filter -->
    <record id="purchase_new_view_search" model="ir.ui.view">
        <field name="name">purchase.new.select</field>
        <field name="model">purchase.new</field>
        <field name="arch" type="xml">
            <search string="Search Purchase New">
                <field name="name" string="Name"/>
                <field name="partner_id" operator="child_of"/>
                <group expand="0" string="Group By">
                    <filter string="Vendor" name="vendor" domain="[]" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="view_purchase_new_kanban">
        <field name="name">purchase.new.kanban</field>
        <field name="model">purchase.new</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" quick_create="false">
                <field name="name"/>
                <field name="partner_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline">
                            <field name="partner_id" class="fw-bolder fs-5 me-2"/>
                        </div>
                        <footer class="align-items-end">
                            <div class="d-flex flex-wrap gap-1 text-nowrap">
                                <field name="name"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Wizard View -->
    <record id="view_purchase_new_wizard_form" model="ir.ui.view">
        <field name="name">purchase.new.wizard.form</field>
        <field name="model">purchase.new.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Confirmation">
                <group>
                    <field name="note"/>
                    <field name="confirm"/>
                </group>

                <footer>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_new_wizard" model="ir.actions.act_window">
        <field name="name">Confirm Purchase</field>
        <field name="res_model">purchase.new.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_purchase_new_wizard_form"/>
        <field name="target">new</field>
    </record>


    <!-- MENU ROOT -->
    <!--    <menuitem id="menu_my_root" name="My Module"/>-->

    <!-- MENU ITEM -->
    <menuitem id="menu_purchase_new"
              name="Purchase New"
              parent="purchase.menu_procurement_management"
              action="action_purchase_new" sequence="16" groups="base.group_user"/>
</odoo>