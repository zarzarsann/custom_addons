<odoo>
    <record id="action_report_sale_order_custom" model="ir.actions.report">
        <field name="name">Custom Sale Order</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_internal.report_sale_order_custom_document</field>
        <field name="report_file">sale_order_custom</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <menuitem id="menu_sale_reports_custom"
              name="Custom Sale Order Reports"
              parent="sale.sale_menu_root"
              sequence="10"/>

    <menuitem id="menu_sale_order_custom_pdf"
              name="Custom Sale Orders"
              parent="menu_sale_reports_custom"
              action="action_report_sale_order_custom"
              sequence="1"/>
</odoo>